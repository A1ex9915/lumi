PORT=8000
# Cambia este secreto en producción
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
# AI_PROVIDER: openai, anthropic o gemini
AI_PROVIDER=openai
# Clave de https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# (Opcional) Clave de https://console.anthropic.com para usar Claude
ANTHROPIC_API_KEY=
# Modelo de Claude (por defecto claude-opus-5-5; más barato: claude-sonnet-5-5 o claude-haiku-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# Clave GRATIS de https://aistudio.google.com/apikey para usar Gemini (AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Usuario administrador que se crea al iniciar si no existe
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
# Ruta del archivo de base de datos SQLite
DB_PATH=./data/chatbot.db
# Proyecto de Firebase para el inicio de sesión con Google
FIREBASE_PROJECT_ID=gen-lang-client-0815449786
